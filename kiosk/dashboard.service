[Unit]
Description=Power Dashboard Backend
After=network.target

[Service]
Type=simple
User=pugs
WorkingDirectory=/home/pugs/power-dashboard
Environment=PORT=5000
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/pugs/power-dashboard/dashboard_host.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
