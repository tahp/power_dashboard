screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# These assets are authored for the Pi's 800x480 display. Keeping the image
# dimensions equal to the framebuffer avoids relying on backend-specific
# clipping/scaling behavior during the early boot framebuffer handoff.

# Keep the display opaque while the system starts or stops so console output is
# not visible through the splash screen.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

if (Plymouth.GetMode() == "shutdown")
{
    splash = Image("shutdown.png");
}
else
{
    splash = Image("boot.png");
}

splash.SetPosition((screen_width - splash.GetWidth()) / 2,
                   (screen_height - splash.GetHeight()) / 2,
                   100);

# Intentionally no status callback: kernel/systemd messages never appear on screen.
